{
  "name": "@last-notifications-widgets/angular",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Notification bell widget for Angular: framework-free client plus Angular component and theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lst97-oss/last-notifications-widgets.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/lst97-oss/last-notifications-widgets#readme",
  "bugs": {
    "url": "https://github.com/lst97-oss/last-notifications-widgets/issues"
  },
  "exports": {
    ".": {
      "import": "./dist/fesm2022/last-notifications-widgets-angular.mjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/types/last-notifications-widgets-angular.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunx ng-packagr -p ng-package.json && bunx @tailwindcss/cli -i ./src/styles.css -o ./dist/styles.css --minify",
    "typecheck": "bunx ngc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@last-notifications-widgets/client": "workspace:*",
    "@lucide/angular": "^1.66.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0"
  },
  "devDependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@last-notifications-widgets/theme": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "ng-packagr": "22.2.4",
    "rxjs": "^7.8.2",
    "tailwindcss": "4.3.3",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3"
  }
}
