{
  "name": "@lst97-oss/last-notifications-widgets",
  "version": "0.1.0",
  "description": "Notification bell widget for last-notifications: framework-free client plus React component and theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lst97-oss/last-notifications-widgets.git",
    "directory": "packages/last-notifications-widgets"
  },
  "homepage": "https://github.com/lst97-oss/last-notifications-widgets#readme",
  "bugs": {
    "url": "https://github.com/lst97-oss/last-notifications-widgets/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "notifications",
    "inbox",
    "bell",
    "react",
    "last-notifications"
  ],
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/client/server.d.ts",
      "import": "./dist/client/server.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
