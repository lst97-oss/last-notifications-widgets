{
  "name": "@lst97-oss/last-notifications-widgets",
  "version": "0.1.0",
  "description": "Notification bell widget for last-notifications: framework-free client plus React, Vue, Angular and vanilla components and theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lst97-oss/last-notifications-widgets.git",
    "directory": "packages/last-notifications-widgets"
  },
  "homepage": "https://github.com/lst97-oss/last-notifications-widgets#readme",
  "bugs": {
    "url": "https://github.com/lst97-oss/last-notifications-widgets/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "notifications",
    "inbox",
    "bell",
    "react",
    "vue",
    "angular",
    "vanilla-js",
    "last-notifications"
  ],
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./server": {
      "types": "./dist/client/server.d.ts",
      "import": "./dist/client/server.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./react/styles.css": "./dist/react/styles.css",
    "./vue/styles.css": "./dist/vue/styles.css",
    "./package.json": "./package.json",
    "./vanilla": {
      "types": "./dist/vanilla/index.d.ts",
      "import": "./dist/vanilla/index.js"
    },
    "./vanilla/styles.css": "./dist/vanilla/styles.css",
    "./angular": {
      "types": "./dist/angular/types/last-notifications-widgets-angular.d.ts",
      "import": "./dist/angular/fesm2022/last-notifications-widgets-angular.mjs"
    },
    "./angular/styles.css": "./dist/angular/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
