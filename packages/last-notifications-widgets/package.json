  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@lucide/angular": "^1.66.0",
    "@lucide/vue": "^1.61.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44"
  },
  "peerDependenciesMeta": {
