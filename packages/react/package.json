{
  "name": "@last-notifications-widgets/react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React notification bell built on the framework-free client.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunx tsup && bunx @tailwindcss/cli -i ./src/styles.css -o ./dist/styles.css",
    "typecheck": "bun check --no-script"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@last-notifications-widgets/client": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@last-notifications-widgets/theme": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.2",
    "tailwindcss": "4.3.3",
    "tsup": "^9.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
