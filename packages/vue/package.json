{
  "name": "@last-notifications-widgets/vue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Notification bell widget for Vue 3: framework-free client plus Vue component and theme.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lst97-oss/last-notifications-widgets.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/lst97-oss/last-notifications-widgets#readme",
  "bugs": {
    "url": "https://github.com/lst97-oss/last-notifications-widgets/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bunx vite build && bunx @tailwindcss/cli -i ./src/styles.css -o ./dist/styles.css --minify",
    "typecheck": "vue-tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@last-notifications-widgets/client": "workspace:*",
    "@lucide/vue": "^1.61.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "vue": "~3.5.44"
  },
  "devDependencies": {
    "@last-notifications-widgets/theme": "workspace:*",
    "@tailwindcss/cli": "4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  }
}
